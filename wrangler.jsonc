{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcome-to-shenzhen",
  "main": "worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "langcode.app/shenzhen*",
      "zone_name": "langcode.app"
    }
  ]
}
